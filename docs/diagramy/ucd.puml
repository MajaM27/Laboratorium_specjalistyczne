@startuml PetCare_UCD
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Właściciel\nzwierzęcia" as Owner

rectangle "System PetCare" {
  usecase "Zarejestruj się\n(PU-01)" as UC1
  usecase "Zaloguj się\n(PU-02)" as UC2
  usecase "Wyloguj się\n(PU-05)" as UC5

  usecase "Zarządzaj zwierzętami\n(PU-03)" as UC3
  usecase "Dodaj zwierzę" as UC3a
  usecase "Edytuj / usuń zwierzę" as UC3b
  usecase "Wyszukaj zwierzę" as UC3c
  usecase "Zobacz szczegóły zwierzęcia" as UC3d

  usecase "Zarządzaj wizytami\n(PU-04)" as UC4
  usecase "Dodaj wizytę" as UC4a
  usecase "Edytuj / usuń wizytę" as UC4b
  usecase "Oznacz wizytę\njako zakończoną" as UC4c
  usecase "Filtruj wizyty\nwedług daty" as UC4d
}

Owner --> UC1
Owner --> UC2
Owner --> UC3
Owner --> UC4
Owner --> UC5

UC3 ..> UC2 : <<include>>
UC4 ..> UC2 : <<include>>

UC3a ..> UC3 : <<extend>>
UC3b ..> UC3 : <<extend>>
UC3c ..> UC3 : <<extend>>
UC3d ..> UC3 : <<extend>>

UC4a ..> UC4 : <<extend>>
UC4b ..> UC4 : <<extend>>
UC4c ..> UC4 : <<extend>>
UC4d ..> UC4 : <<extend>>
@enduml
