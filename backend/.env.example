# Środowisko: development | production
NODE_ENV=development

# Port serwera API
PORT=3001

# Ścieżka do pliku bazy SQLite (względem katalogu backend/)
DATABASE_PATH=./data/petcare.db

# Sekret do podpisywania tokenów JWT – w produkcji długi, losowy ciąg!
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag
# Czas ważności tokenu (np. 2h, 1d)
JWT_EXPIRES_IN=2h

# Liczba rund bcrypt (koszt haszowania haseł)
BCRYPT_ROUNDS=10

# Adres frontendu, z którego API przyjmuje żądania (CORS)
CORS_ORIGIN=http://localhost:5180
